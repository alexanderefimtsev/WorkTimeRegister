<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkTimeRegister.ViewModels"
        x:Class="WorkTimeRegister.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Учёт рабочего времени"
        Icon="avares://WorkTimeRegister/Assets/AppIcon-1024.png"
        Width="900" MinWidth="840" MinHeight="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <StreamGeometry x:Key="PlayIcon">M3,2 L14,8 L3,14 Z</StreamGeometry>
    <StreamGeometry x:Key="PauseIcon">M3,2 L7,2 L7,14 L3,14 Z M9,2 L13,2 L13,14 L9,14 Z</StreamGeometry>
    <StreamGeometry x:Key="BreakIcon">M2,3 L12,3 L12,10 C12,13 10,15 7,15 C4,15 2,13 2,10 Z M12,5 L15,5 L15,10 L12,10 Z</StreamGeometry>
    <StreamGeometry x:Key="TransferIcon">M2,4 L11,4 L11,2 L15,5 L11,8 L11,6 L2,6 Z M14,10 L5,10 L5,8 L1,11 L5,14 L5,12 L14,12 Z</StreamGeometry>
    <StreamGeometry x:Key="JournalIcon">M2,2 L14,2 L14,14 L2,14 Z M4,4 L12,4 L12,6 L4,6 Z M4,8 L12,8 L12,10 L4,10 Z M4,12 L9,12 L9,13 L4,13 Z</StreamGeometry>
    <StreamGeometry x:Key="PlusIcon">M7,2 L9,2 L9,7 L14,7 L14,9 L9,9 L9,14 L7,14 L7,9 L2,9 L2,7 L7,7 Z</StreamGeometry>
    <StreamGeometry x:Key="MinusIcon">M2,7 L14,7 L14,9 L2,9 Z</StreamGeometry>
    <StreamGeometry x:Key="DeleteIcon">M3,4 L13,4 L12,15 L4,15 Z M5,2 L11,2 L12,4 L4,4 Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.toolbar">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.adjustment">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16" Margin="24">
    <StackPanel Spacing="4">
      <TextBlock Text="Учёт рабочего времени" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="{Binding WorkDayStatus}" FontSize="14" Opacity="0.7" />
    </StackPanel>

    <Border Grid.Row="1" Background="#10708090" CornerRadius="10" Padding="8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Button Classes="toolbar" Command="{Binding ToggleWorkDayCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="■" FontSize="16" VerticalAlignment="Center" IsVisible="{Binding IsWorkDayOpen}" />
              <TextBlock Text="▶" FontSize="16" VerticalAlignment="Center" IsVisible="{Binding !IsWorkDayOpen}" />
              <TextBlock Text="{Binding WorkDayActionText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Click="OpenTransferDialog" IsEnabled="{Binding IsReady}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource TransferIcon}" Width="16" Height="16" />
              <TextBlock Text="Изменить время" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Click="OpenActionLog">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource JournalIcon}" Width="16" Height="16" />
              <TextBlock Text="Журнал действий" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Click="OpenSettings" IsEnabled="{Binding IsReady}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="⚙" FontSize="18" VerticalAlignment="Center" />
              <TextBlock Text="Настройки" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,16,0,0" VerticalAlignment="Center" Spacing="18">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Background="#182B66F6" CornerRadius="12" Padding="16">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="adjustment" Tag="Add" Click="AdjustWorkTime" ToolTip.Tip="Добавить рабочее время">
                <PathIcon Data="{StaticResource PlusIcon}" Width="14" Height="14" />
              </Button>
              <Button Classes="adjustment" Tag="Remove" Click="AdjustWorkTime"
                      IsEnabled="{Binding CanReduceWork}" ToolTip.Tip="Вычесть рабочее время">
                <PathIcon Data="{StaticResource MinusIcon}" Width="14" Height="14" />
              </Button>
              <Button Classes="adjustment" Tag="Clear" Click="AdjustWorkTime"
                      IsEnabled="{Binding CanReduceWork}" ToolTip.Tip="Очистить рабочее время">
                <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" />
              </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Работа сегодня" FontSize="15" />
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding WorkTime}" VerticalAlignment="Center"
                         FontSize="34" FontWeight="Bold" />
              <Button Grid.Column="2" Classes="toolbar" Command="{Binding StartWorkCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource PlayIcon}" Width="16" Height="16" />
                  <TextBlock Text="Продолжить работу" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#18F59E0B" CornerRadius="12" Padding="16">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="adjustment" Tag="Add" Click="AdjustBreakTime" ToolTip.Tip="Добавить время перерыва">
                <PathIcon Data="{StaticResource PlusIcon}" Width="14" Height="14" />
              </Button>
              <Button Classes="adjustment" Tag="Remove" Click="AdjustBreakTime"
                      IsEnabled="{Binding CanReduceBreak}" ToolTip.Tip="Вычесть время перерыва">
                <PathIcon Data="{StaticResource MinusIcon}" Width="14" Height="14" />
              </Button>
              <Button Classes="adjustment" Tag="Clear" Click="AdjustBreakTime"
                      IsEnabled="{Binding CanReduceBreak}" ToolTip.Tip="Очистить время перерыва">
                <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" />
              </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Перерывы сегодня" FontSize="15" />
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding BreakTime}" VerticalAlignment="Center"
                         FontSize="34" FontWeight="Bold" />
              <Button Grid.Column="2" Classes="toolbar" Command="{Binding StartBreakCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource BreakIcon}" Width="16" Height="16" />
                  <TextBlock Text="Начать перерыв" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Background="#10708090" CornerRadius="12" Padding="16">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="adjustment" Tag="Add" Click="AdjustCurrentTime"
                    IsEnabled="{Binding CanAdjustCurrentPeriod}" ToolTip.Tip="Добавить время в текущий период">
              <PathIcon Data="{StaticResource PlusIcon}" Width="14" Height="14" />
            </Button>
            <Button Classes="adjustment" Tag="Remove" Click="AdjustCurrentTime"
                    IsEnabled="{Binding CanReduceCurrentPeriod}" ToolTip.Tip="Вычесть время из текущего периода">
              <PathIcon Data="{StaticResource MinusIcon}" Width="14" Height="14" />
            </Button>
            <Button Classes="adjustment" Tag="Clear" Click="AdjustCurrentTime"
                    IsEnabled="{Binding CanReduceCurrentPeriod}" ToolTip.Tip="Очистить текущий период">
              <PathIcon Data="{StaticResource DeleteIcon}" Width="14" Height="14" />
            </Button>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{Binding CurrentPeriodTitle}"
                     HorizontalAlignment="Center" FontSize="17" Opacity="0.75" />
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*">
            <TextBlock Grid.Column="1" Text="{Binding CurrentPeriod}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="42" FontWeight="SemiBold" />
            <Button Grid.Column="2" Classes="toolbar" Command="{Binding TogglePauseCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource PauseIcon}" Width="16" Height="16"
                          IsVisible="{Binding IsNotPaused}" />
                <PathIcon Data="{StaticResource PlayIcon}" Width="16" Height="16"
                          IsVisible="{Binding IsPaused}" />
                <TextBlock Text="{Binding PauseActionText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="3" Spacing="6">
    <Border IsVisible="{Binding HasClockConflict}" Background="#25F59E0B" CornerRadius="8" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock Text="Системное время изменилось" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ClockConflictMessage}" TextWrapping="Wrap" />
        <Button Content="Проверить время" Click="RetryClock" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <Border IsVisible="{Binding HasError}"
            Background="#25EF4444" CornerRadius="8" Padding="12">
      <StackPanel Spacing="6">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" />
      <Button Content="Повторить обработку события" IsVisible="{Binding HasPendingPowerEvents}" Click="RetryPowerEvents" />
      </StackPanel>
    </Border>
    <Border IsVisible="{Binding HasIntegrationWarning}" Background="#25F59E0B" CornerRadius="8" Padding="12">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding IntegrationWarning}" TextWrapping="Wrap" />
        <Button Content="Повторить подключение" Click="RetryIntegrations" />
      </StackPanel>
    </Border>
    </StackPanel>
  </Grid>
</Window>
