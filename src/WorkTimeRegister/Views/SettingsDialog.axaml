<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WorkTimeRegister.Views.SettingsDialog"
        x:CompileBindings="False"
        Title="Настройки рабочего дня"
        Icon="avares://WorkTimeRegister/Assets/AppIcon-1024.png"
        Width="610" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="24" RowSpacing="20">
    <TextBlock Text="Настройки рабочего дня" FontSize="24" FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" Spacing="18">
      <StackPanel Spacing="4">
        <CheckBox x:Name="AutoStartCheckBox" Content="Начинать рабочий день при запуске программы" />
        <TextBlock Margin="28,0,0,0" TextWrapping="Wrap" Opacity="0.7"
                   Text="Если сегодня день ещё не начинался, открыть его и сразу включить режим «Работа»." />
      </StackPanel>
      <StackPanel Spacing="4">
        <CheckBox x:Name="RestoreCheckBox" Content="Восстанавливать день при повторном запуске" />
        <TextBlock Margin="28,0,0,0" TextWrapping="Wrap" Opacity="0.7"
                   Text="Только в ту же дату и после выхода из программы. Вернуть прежний режим и паузу; время вне программы не учитывать. Ручное завершение дня не отменяется." />
      </StackPanel>
      <StackPanel Spacing="4">
        <CheckBox x:Name="AutoContinueCheckBox" Content="Продолжать рабочий день после полуночи" />
        <TextBlock Margin="28,0,0,0" TextWrapping="Wrap" Opacity="0.7"
                   Text="Закрыть прежний день и открыть новый с тем же режимом и паузой. Завершённый день не возобновляется." />
      </StackPanel>
      <TextBlock TextWrapping="Wrap" Opacity="0.7"
                 Text="Красный крестик скрывает окно и сохраняет учёт. «Выйти» и Cmd+Q завершают рабочий день. Настройки применяются после сохранения; запуск дня проверяется при следующем открытии программы." />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Отмена" MinWidth="100" HorizontalContentAlignment="Center" Click="CancelClicked" />
      <Button Content="Сохранить" MinWidth="110" HorizontalContentAlignment="Center" Click="SaveClicked" />
    </StackPanel>
  </Grid>
</Window>
